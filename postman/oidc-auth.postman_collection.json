                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/utils/createPublicKey"
          }
        },
        {
          "name": "Convert JWK to PEM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kty\": \"RSA\",\n  \"n\": \"u1SU1LfQuPtweZ243vG2938Q4j9uF0aA_sample_key_modulus\",\n  \"e\": \"AQAB\"\n}"
            },
            "url": "{{baseUrl}}/utils/createPublicKey"
          }
        }
      ]
