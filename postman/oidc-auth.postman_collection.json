    {
      "name": "OIDC",
      "item": [
        {
          "name": "Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/oidc/.well-known/openid-configuration"
          }
        },
        {
          "name": "JWKS",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/oidc/jwks"
          }
        },
        {
          "name": "Authorization URL",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const bytes = CryptoJS.lib.WordArray.random(32);",
                  "const verifier = CryptoJS.enc.Base64.stringify(bytes).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const challenge = CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.collectionVariables.set('codeVerifier', verifier);",
                  "pm.collectionVariables.set('codeChallenge', challenge);",
                  "pm.collectionVariables.set('state', CryptoJS.lib.WordArray.random(16).toString());",
                  "pm.collectionVariables.set('nonce', CryptoJS.lib.WordArray.random(16).toString());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oidc/auth?client_id=local-web&redirect_uri=http%3A%2F%2Flocalhost%3A3001%2Fcallback&response_type=code&scope=openid%20profile%20email&state={{state}}&nonce={{nonce}}&code_challenge={{codeChallenge}}&code_challenge_method=S256",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "auth"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "local-web"
                },
                {
                  "key": "redirect_uri",
                  "value": "http%3A%2F%2Flocalhost%3A3001%2Fcallback"
                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "scope",
                  "value": "openid%20profile%20email"
                },
                {
                  "key": "state",
                  "value": "{{state}}"
                },
                {
                  "key": "nonce",
                  "value": "{{nonce}}"
                },
                {
                  "key": "code_challenge",
                  "value": "{{codeChallenge}}"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                }
              ]
            }
          }
        },
        {
          "name": "Exchange Authorization Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "local-web"
                },
                {
                  "key": "client_secret",
                  "value": "local-web-secret"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:3001/callback"
                },
                {
                  "key": "code",
                  "value": "{{authorizationCode}}"
                },
                {
                  "key": "code_verifier",
                  "value": "{{codeVerifier}}"
                }
              ]
            },
            "url": "{{baseUrl}}/oidc/token"
          }
        },
        {
          "name": "User Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/oidc/me"
          }
        }
      ]
    }
