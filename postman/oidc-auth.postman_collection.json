        {
          "name": "Register (Bootstrap Super Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.idToken) pm.collectionVariables.set('idToken', body.idToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "if (body.claims && body.claims.sub) pm.collectionVariables.set('userId', body.claims.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Alice Super Admin\",\n  \"address\": \"Platform HQ, Example City\",\n  \"phone\": \"+1-555-0100\"\n}"
