NODE_ENV=development
PORT=3000
ISSUER_URL=http://localhost:3000
OIDC_ISSUER_URL=http://localhost:3000/oidc
# Inside Compose, use host `postgres` and port 5432.
# From the host machine, use localhost:5433 (Compose publishes 5433 to avoid clashing with a local Postgres on 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_service
REDIS_URL=redis://redis:6379
# Optional RSA private JWK (JSON) for stable RS256 signing. Omit in local dev to auto-generate per process.
# OIDC_SIGNING_PRIVATE_JWK=
ID_TOKEN_AUDIENCE=auth-api
ACCESS_TOKEN_TTL=900
ID_TOKEN_TTL=900
AUTHORIZATION_CODE_TTL=300
REFRESH_TOKEN_TTL=2592000